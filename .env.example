# TrustNet AI configuration example.
# Copy to .env and adjust:   Copy-Item .env.example .env
# .env is git-ignored. Nothing here is a secret; do not add secrets to this file.

# development | test | production
TRUSTNET_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
TRUSTNET_LOG_LEVEL=INFO

# SQLite database file (created on first use; the data/ directory is git-ignored)
TRUSTNET_DATABASE_PATH=data/trustnet.db

# The model backend. Only "ollama" (local inference) is available.
TRUSTNET_LLM_PROVIDER=ollama

TRUSTNET_OLLAMA_BASE_URL=http://localhost:11434

# REQUIRED. There is no default, because the models installed differ per machine.
# Use a name exactly as `ollama list` prints it, for example llama3.2:1b
TRUSTNET_OLLAMA_MODEL=

# Seconds each agent may take to reply. The agents share one local model, so this
# also has to cover time an agent spends queued behind the others.
TRUSTNET_OLLAMA_TIMEOUT_SECONDS=600

# --- Trust engine (optional; defaults shown) ---
# Verified answers an agent needs before it gets a trust score at all.
TRUSTNET_TRUST_MIN_SAMPLES=5
# Relative weight of each signal in the trust score. Signals with no data are left
# out and the rest are re-normalised, so these need not sum to 1.
TRUSTNET_WEIGHT_HISTORICAL_ACCURACY=0.40
TRUSTNET_WEIGHT_CALIBRATION=0.20
TRUSTNET_WEIGHT_EVIDENCE_QUALITY=0.15
TRUSTNET_WEIGHT_CONSISTENCY=0.15
TRUSTNET_WEIGHT_INSUFFICIENT_INFORMATION_BEHAVIOR=0.10

# --- Decision engine (optional; defaults shown) ---
# Share of reliability weight the leading answer needs, else the system abstains.
TRUSTNET_DECISION_MIN_SUPPORT=0.6
# Trust score at least one supporter of the leading answer must have.
TRUSTNET_DECISION_MIN_TRUST=0.5
TRUSTNET_DECISION_REQUIRE_VERIFIED_EVIDENCE=false

# --- Evidence checking (optional) ---
# Folder of text files agents may cite by file name. Unset = nothing can be verified.
# TRUSTNET_EVIDENCE_DIR=data/sources
# Also ask the local model whether a source supports a claim (slower).
TRUSTNET_EVIDENCE_LLM_JUDGE=false
